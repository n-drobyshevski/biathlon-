# ============================================================================
#  DÉCAFLOP CTF — FLAG CONFIG
# ----------------------------------------------------------------------------
#  Do NOT commit the real .env. This file is a template.
#  On the Pi, run:   ./scripts/gen-flags.sh
#  That creates a .env with fresh random flags, so even if this repo is
#  public your team cannot read the answers from git.
#
#  Format:  TRIATHLON{...}
#  The XXXX parts are replaced with random tokens by gen-flags.sh.
# ============================================================================

# --- Easy ---
FLAG_01_STAFF=TRIATHLON{XXXX}
FLAG_02_STEGO=TRIATHLON{XXXX}
FLAG_03_EXIF=TRIATHLON{XXXX}

# --- Medium ---
FLAG_04_IDOR=TRIATHLON{XXXX}
FLAG_05_PCAP=TRIATHLON{XXXX}
FLAG_06_SQLI=TRIATHLON{XXXX}
FLAG_07_USB=TRIATHLON{XXXX}

# --- Hard (SAP) ---
FLAG_09_SAP_USR02=TRIATHLON{XXXX}

# Audit complémentaire (missions 10-15)
FLAG_10_JWT=TRIATHLON{XXXX}
FLAG_11_GIT=TRIATHLON{XXXX}
FLAG_12_SSTI=TRIATHLON{XXXX}
FLAG_13_SAP_SHORTCUT=TRIATHLON{XXXX}
FLAG_14_SAP_GW=TRIATHLON{XXXX}
FLAG_15_SAP_ABAP=TRIATHLON{XXXX}

# --- Story: the saboteur's name revealed by the finale (challenge 09) ---
# Keep in sync with handouts if you change it.
SABOTEUR_NAME=viktor_lindqvist

# --- Results API signing secret (challenges 10 & 11) ---
# The HS256 secret players crack in 10. The SAME value is leaked in 11's git
# history (an alternate route into 10), so docker-compose passes it to both.
# Not a flag; the default below is 10's own weak default. Override to rotate it.
# JWT_SECRET=DecaFlop2026

# --- Internal file share "Partage DFlop" (:8020) ---
# Crew login for the share. Players learn it by solving challenge 01 (the staff
# portal shows it). These are ACCESS CREDENTIALS given to players, not secret
# flags; the defaults are fine for an event. The SAME values feed both the
# share service and the 01 staff portal, so overriding here keeps them in sync.
# SHARE_USER=equipe-it
# SHARE_PASSWORD=transition2026

# --- Mode guidé: beginner walkthrough on the hub (:8080) ---
# Optional step-by-step guide per mission, gated by a simple password so
# ordinary players do not stumble into spoilers. Hand the word to teams that
# want the training wheels. Not a flag; the default is fine for an event.
# GUIDE_PASSWORD=debutant

# --- CTFd scoreboard ---
CTFD_SECRET_KEY=XXXX                 # generated by gen-flags.sh, kept across rotations
# CTFD_TOKEN=ctfd_...                # admin token, for scripts/ctfd-setup.py
# CTF_HOST=192.168.8.2               # address players use (CTFd descriptions)
# SCOREBOARD_URL=http://192.168.8.2:8000   # optional override of the hub's scoreboard link

# --- Online hosting (OPTIONAL): Cloudflare Tunnel + Access, see CLOUDFLARE.md ---
# Leave these commented for the normal offline Pi event. Only used with:
#   docker compose -f docker-compose.yml -f docker-compose.cloudflare.yml up -d
# TUNNEL_TOKEN: the tunnel's connector token (Zero Trust > Networks > Tunnels).
#   It is a SECRET: anyone holding it can serve your hostnames. Never commit it.
# TUNNEL_TOKEN=
# CTF_DOMAIN: base domain of the lab subdomains (hub.<domain>, ctfd.<domain>, ...).
#   Also read by scripts/ctfd-setup.py for the online Connect links.
# CTF_DOMAIN=ctf.example.com
# BIND_ADDR: host address the published ports bind to. Unset = every interface
#   (offline default). Online set it to 127.0.0.1 (the overlay pins loopback too).
# BIND_ADDR=127.0.0.1
