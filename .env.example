# ============================================================================
#  DÉCAFLOP CTF — FLAG CONFIG
# ----------------------------------------------------------------------------
#  Do NOT commit the real .env. This file is a template.
#  On the Pi, run:   ./scripts/gen-flags.sh
#  That creates a .env with fresh random flags, so even if this repo is
#  public your team cannot read the answers from git.
#
#  Format:  TRIATHLON{...}
#  The XXXX parts are replaced with random tokens by gen-flags.sh.
# ============================================================================

# --- Easy ---
FLAG_01_STAFF=TRIATHLON{XXXX}
FLAG_02_STEGO=TRIATHLON{XXXX}
FLAG_03_EXIF=TRIATHLON{XXXX}

# --- Medium ---
